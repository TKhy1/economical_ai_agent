# Copy this file to .env and fill in your key to enable the LLM-powered chat assistant
# (POST /api/chat). An empty value or the placeholder below is treated as unconfigured,
# so the chat feature falls back to the built-in rule-based parser in agent.py.
AI_API_KEY=Enter AI API

# Optional: override the Claude model used for chat (defaults to claude-sonnet-5).
# AI_MODEL=claude-sonnet-5
