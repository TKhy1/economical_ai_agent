# ===========================================================================
# CampusWallet 对话后端配置
# 默认接 DeepSeek：复制为 .env 后，只需要改下面第 1 行就能跑通。
# 原本用 Claude 的部署：什么都不用改，见文件末尾「Claude 兼容性」。
# ===========================================================================

# 1) 必填：把占位符换成你的真实 Key（申请：https://platform.deepseek.com/api_keys）
#    注意：这一行前面不能有 #、也不要加引号，否则等于没配置。
DEEPSEEK_API_KEY=Enter DeepSeek API Key

# ---------------------------------------------------------------------------
# 2) 选模型（可选）：默认就是 deepseek-flash，也就是 V4.1 Flash。
#    想要旗舰版就用 deepseek-v4-pro；下面这些写法在官方端点上等价，
#    都会自动映射为 deepseek-flash：
#      deepseek-v4.1-flash / deepseek-v41-flash / DeepSeek-V4.1-Flash / deepseek-v4-flash
# 取消下一行的注释即可覆盖默认模型：
# AI_MODEL=deepseek-flash

# ---------------------------------------------------------------------------
# 3) 其它可选项：保持注释 = 使用默认值，改成实际值才生效。
# AI_PROVIDER=deepseek            # deepseek（默认）| anthropic（Claude）
# AI_BASE_URL=https://api.deepseek.com
# AI_TIMEOUT=30                   # 超时秒数；不设时 DeepSeek 30s、Claude 用 SDK 默认
# AI_MAX_TOKENS=600               # 输出上限；不设时 DeepSeek 600、Claude 400
# AI_TEMPERATURE=0.7              # 采样温度（思考模式下不生效）
# AI_THINKING=auto                # auto | enabled | disabled
# AI_REASONING_EFFORT=high        # low | high | max（仅思考模式）
# AI_CONTEXT=true                 # 是否注入只读预算快照（Claude 也可用 AI_CONTEXT=false 关闭）
# AI_MAX_RETRIES=1                # 429/5xx/网络错误的重试次数

# ---------------------------------------------------------------------------
# 4) 走第三方 OpenAI 兼容网关（示例：阿里云百炼，那里管同一个模型叫 deepseek-v4.1-flash）：
# AI_PROVIDER=openai
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_MODEL=deepseek-v4.1-flash
# AI_API_KEY=你的 DashScope Key

# ---------------------------------------------------------------------------
# 5) Claude 兼容性（原有接入完全保留，旧配置不用改）
#   - 只设置 ANTHROPIC_API_KEY，或只设置通用 AI_API_KEY → 仍然走 Claude；
#   - 默认模型仍是 claude-sonnet-5，默认 max_tokens 仍是 400，超时用 SDK 默认值；
#   - AI_MODEL 里的 claude-* 名字不会被任何别名映射改写；
#   - 想显式指定也可以：
# AI_PROVIDER=anthropic
# AI_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=Enter Anthropic API Key
#
# 文件编码：记事本保存为 UTF-8 即可；带 BOM 或用 ANSI/GBK 保存也能正确读取。
# 改完 .env 需要重启 app.py 才生效；更多说明见 README-CN.md 的「配置」一节。
